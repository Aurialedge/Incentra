# ==========================================
# Incentra - Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Environment & Sensitive Credentials (CRITICAL)
# ------------------------------------------
.env
.env.*
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
# Exceptions: Keep example templates tracked
!.env.example
!*.env.example
!**/.env.example

# Private Keys, Certificates & Secret Files
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
secrets.*
credentials.*
serviceAccountKey.json

# ------------------------------------------
# Node Dependencies & Package Managers
# ------------------------------------------
node_modules/
*/node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Python Environments & Bytecode Cache
# ------------------------------------------
.venv/
*/.venv/
**/ .venv/
venv/
*/venv/
env/
*/env/
ENV/
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------
# Application Logs & Diagnostics
# ------------------------------------------
logs/
**/logs/
*.log
ml/credit_score_warnings.log

# ------------------------------------------
# Build & Compilation Outputs
# ------------------------------------------
dist/
*/dist/
**/dist/
build/
*/build/
dist-ssr/
*.local

# ------------------------------------------
# Database Dumps & Local Data
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
dump.rdb

# ------------------------------------------
# IDE & Operating System Artifacts
# ------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tmp
*.bak
